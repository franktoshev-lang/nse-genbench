# Copy to .env (gitignored). Never commit real values.

# --- Stage 3: model endpoint ------------------------------------------
# Any OpenAI-compatible chat-completions API. The base URL includes the
# version path; requests go to {MODEL_BASE_URL}/chat/completions.
#   local llama-server:  http://127.0.0.1:8080/v1
# Leave MODEL_BASE_URL empty until access exists; only mock:* runs then work.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# --- Run controls -----------------------------------------------------
# Seed sent with every request. Set it empty if a provider rejects "seed".
GENBENCH_SEED=42
GENBENCH_OUT_DIR=out

# --- Tests ------------------------------------------------------------
# Path to a clone of r-huijts/NSE_Applied_GenAI. When set (as a real
# environment variable), tests compare the prompts against it live.
NSE_REPO_PATH=
